# Extraction/metadata for mem_copy_bw (KEY=VALUE; parsed by run.sh)
CATEGORY=memory
BINARY=bw_mem
METRIC_TYPE=bandwidth
UNIT=MB/s
BIGGER_IS_BETTER=1
# bw_mem prints "<size_MB> <bandwidth_MB/s>" to stderr; take the bandwidth (last field).
SEARCH_PATTERN=^[0-9]
RESULT_INDEX=NF
NTH_OCCURRENCE=1
DESCRIPTION=Memory copy bandwidth via bw_mem fcp (64MB)
