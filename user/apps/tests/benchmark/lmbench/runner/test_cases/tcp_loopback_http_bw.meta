# Extraction/metadata for tcp_loopback_http_bw (KEY=VALUE; parsed by run.sh)
CATEGORY=network
BINARY=lat_http
METRIC_TYPE=bandwidth
UNIT=MB/s
BIGGER_IS_BETTER=1
# lat_http prints "Avg xfer: ... <Y> MB/sec"; extract decimal megabytes/sec.
SEARCH_PATTERN=Avg xfer
RESULT_INDEX=NF-1
NTH_OCCURRENCE=1
DESCRIPTION=TCP loopback HTTP bandwidth via lat_http (lmhttp server)
