# Extraction/metadata for vfs_fstat_lat (KEY=VALUE; parsed by run.sh)
CATEGORY=vfs
BINARY=lat_syscall
METRIC_TYPE=latency
UNIT=microseconds
BIGGER_IS_BETTER=0
# lat_syscall fstat prints "Simple fstat: <N> microseconds".
SEARCH_PATTERN=Simple fstat
RESULT_INDEX=NF-1
NTH_OCCURRENCE=1
DESCRIPTION=fstat syscall latency via lat_syscall fstat